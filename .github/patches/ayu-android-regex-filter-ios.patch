+/// AyuGram Android's regex-filter settings, stored independently so old client
+/// preferences remain readable when this module is added.
+public struct AyuGramRegexFilterSettings: Codable, Equatable {
+    public var enabled = false
+    public var caseInsensitive = true
+    public var privateChatsOnly = false
+    public var patterns: [String] = []
+
+    public init() {}
+
+    public init(from decoder: Decoder) throws {
+        let container = try decoder.container(keyedBy: CodingKeys.self)
+        let defaults = AyuGramRegexFilterSettings()
+        self.enabled = try container.decodeIfPresent(Bool.self, forKey: .enabled) ?? defaults.enabled
+        self.caseInsensitive = try container.decodeIfPresent(Bool.self, forKey: .caseInsensitive) ?? defaults.caseInsensitive
+        self.privateChatsOnly = try container.decodeIfPresent(Bool.self, forKey: .privateChatsOnly) ?? defaults.privateChatsOnly
+        self.patterns = try container.decodeIfPresent([String].self, forKey: .patterns) ?? defaults.patterns
+    }
+}
+
+/// Native iOS implementation of AyuGram4A's AyuFilter matching behavior.
+/// AyuFilter.java copyright @Radolyn, 2023; adapted for Foundation regex APIs.
+public final class AyuGramRegexFilter {
+    public static let shared = AyuGramRegexFilter()
+
+    private let defaults: UserDefaults
+    private let storageKey = "ayugram.regexFilters.v1"
+    private let lock = NSLock()
+    private var cachedSettings: AyuGramRegexFilterSettings?
+    private var cachedExpressions: [(String, NSRegularExpression)] = []
+
+    public init(defaults: UserDefaults = .standard) {
+        self.defaults = defaults
+    }
+
+    public var settings: AyuGramRegexFilterSettings {
+        lock.lock()
+        defer { lock.unlock() }
+        return readSettings()
+    }
+
+    public func update(_ transform: (inout AyuGramRegexFilterSettings) -> Void) {
+        lock.lock()
+        var value = readSettings()
+        transform(&value)
+        if let data = try? JSONEncoder().encode(value) {
+            defaults.set(data, forKey: storageKey)
+        }
+        cachedSettings = value
+        cachedExpressions = compile(value)
+        lock.unlock()
+    }
+
+    /// Returns the first matching expression, like AyuGram4A's AyuFilter.
+    /// Matching is restricted to incoming chat messages by the message renderer.
+    public func matchedPattern(in text: String, isPrivateChat: Bool = false) -> String? {
+        guard !text.isEmpty else { return nil }
+
+        lock.lock()
+        let value = readSettings()
+        if cachedSettings != value {
+            cachedSettings = value
+            cachedExpressions = compile(value)
+        }
+        let enabled = value.enabled
+        let privateChatsOnly = value.privateChatsOnly
+        let expressions = cachedExpressions
+        lock.unlock()
+
+        guard enabled, (!privateChatsOnly || isPrivateChat) else { return nil }
+        // Keep an unexpectedly large message from making rendering work unbounded.
+        let boundedText = String(text.prefix(20_000))
+        let range = NSRange(boundedText.startIndex..<boundedText.endIndex, in: boundedText)
+        for (pattern, expression) in expressions where expression.firstMatch(in: boundedText, range: range) != nil {
+            return pattern
+        }
+        return nil
+    }
+
+    public func containsZalgo(_ text: String) -> Bool {
+        var consecutiveCombiningMarks = 0
+        for scalar in text.unicodeScalars {
+            if CharacterSet.nonBaseCharacters.contains(scalar) {
+                consecutiveCombiningMarks += 1
+                if consecutiveCombiningMarks >= 3 { return true }
+            } else {
+                consecutiveCombiningMarks = 0
+            }
+        }
+        return false
+    }
+
+    public func isValidPattern(_ pattern: String, caseInsensitive: Bool? = nil) -> Bool {
+        let insensitive = caseInsensitive ?? settings.caseInsensitive
+        let options: NSRegularExpression.Options = insensitive ? [.caseInsensitive, .anchorsMatchLines] : [.anchorsMatchLines]
+        return (try? NSRegularExpression(pattern: pattern, options: options)) != nil
+    }
+
+    private func readSettings() -> AyuGramRegexFilterSettings {
+        if let cachedSettings { return cachedSettings }
+        let value = defaults.data(forKey: storageKey).flatMap { try? JSONDecoder().decode(AyuGramRegexFilterSettings.self, from: $0) } ?? AyuGramRegexFilterSettings()
+        cachedSettings = value
+        cachedExpressions = compile(value)
+        return value
+    }
+
+    private func compile(_ settings: AyuGramRegexFilterSettings) -> [(String, NSRegularExpression)] {
+        let options: NSRegularExpression.Options = settings.caseInsensitive ? [.caseInsensitive, .anchorsMatchLines] : [.anchorsMatchLines]
+        return settings.patterns.compactMap { pattern in
+            guard let expression = try? NSRegularExpression(pattern: pattern, options: options) else { return nil }
+            return (pattern, expression)
+        }
+    }
+}
